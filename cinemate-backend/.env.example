# ---------- Server ----------
PORT=3000

# ---------- AI ----------
# Which model provider answers chats and builds summaries: gemini | anthropic
AI_PROVIDER=gemini

# Answer with canned replies instead of calling any AI (no credits used)
USE_MOCK_AI=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Requests per minute allowed by your Gemini plan (free tier is low)
GEMINI_RPM=10

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_RPM=50

# How long a request may wait for rate limits/retries before giving up (ms)
AI_MAX_RETRIES=2
AI_CHAT_MAX_WAIT_MS=8000
AI_SUMMARY_MAX_WAIT_MS=45000

# ---------- Voice ----------
# Local Whisper + pyttsx3 (needs Python 3 + ffmpeg). Set to false to use OpenAI Whisper.
USE_LOCAL_WHISPER=true
USE_LOCAL_TTS=true
WHISPER_MODEL=tiny
# Path to the Python that has openai-whisper and pyttsx3 installed
PYTHON_BIN=python3
# Only needed when USE_LOCAL_WHISPER=false
OPENAI_API_KEY=