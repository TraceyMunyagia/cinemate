{
  "manifest_version": 3,
  "name": "CineMate AI",
  "version": "1.1.0",
  "description": "AI Movie Companion for Netflix, YouTube & Prime Video",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.amazon.com/gp/video/*",
    "http://localhost:3000/*"
  ],

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "action": {
    "default_title": "Open CineMate",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*"
      ],
      "js": [
        "utils/timestamps.js",
        "utils/subtitleCleaner.js",
        "utils/storage.js",
        "platforms/registry.js",
        "platforms/youtube.js",
        "platforms/netflix.js",
        "platforms/primevideo.js",
        "utils/videoInfo.js",
        "utils/mediaControl.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}