{
  "manifest_version": 3,
  "name": "CineMate AI",
  "version": "1.1.0",
  "description": "AI Movie Companion for Netflix & YouTube",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.netflix.com/*",
    "http://localhost:3000/*"
  ],

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "action": {
    "default_title": "Open CineMate",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "utils/timestamps.js",
        "utils/subtitleCleaner.js",
        "utils/storage.js",
        "utils/videoInfo.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}